{
  "name": "@yasuhito/medama",
  "version": "0.1.0",
  "description": "Run scenarios written in Markdown with a small independent JavaScript runner.",
  "license": "MIT",
  "author": "Yasuhito Takamiya",
  "homepage": "https://github.com/yasuhito/medama",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yasuhito/medama.git"
  },
  "type": "commonjs",
  "engines": {
    "node": "^22.19.0 || >=23.6.0"
  },
  "bin": {
    "medama": "bin/medama.cjs"
  },
  "exports": {
    ".": {
      "types": "./lib/steps.d.cts",
      "default": "./lib/steps.cjs"
    }
  },
  "types": "./lib/steps.d.cts",
  "files": [
    "bin/",
    "lib/",
    "examples/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.cjs"
  },
  "dependencies": {
    "markdown-it": "15.0.3"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "typescript": "7.0.2"
  }
}
